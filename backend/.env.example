# SARaksha Backend Environment Configuration Example

# Server Host & Port
HOST=0.0.0.0
PORT=8000
APP_ENV=development

# PostgreSQL / PostGIS Database URL (Optional - defaults to In-Memory repository)
DATABASE_URL=postgresql://saraksha:saraksha_secure_pass@localhost:5432/saraksha_gis

# STAC Satellite Configuration
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a

# Anomaly Thresholds
MAX_CLOUD_COVER=20.0
ANOMALY_NDVI_DROP_THRESHOLD=-10.0
MODERATE_NDVI_DROP_THRESHOLD=-5.0

# Notification Service Provider ('console' | 'smtp' | 'sns')
NOTIFICATION_PROVIDER=console
