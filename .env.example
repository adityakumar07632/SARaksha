# SARaksha Environment Configuration Example
# Copy to .env for local development or configure in Vercel Project Settings

# -------------------------------------------------------------
# 1. Bhuvan ISRO LULC Thematic Statistics API (Optional / Real Data)
# -------------------------------------------------------------
# Token provided by NRSC/Bhuvan for the LULC Thematic API.
# Kept securely on backend only (never exposed to client/browser).
BHUVAN_LULC_API_TOKEN=

# -------------------------------------------------------------
# 2. Frontend API Base URL
# -------------------------------------------------------------
# Local Development: http://localhost:8000
# Production on Vercel: Leave empty or unset (same-origin relative '/api')
VITE_RASTER_API_URL=http://localhost:8000

# -------------------------------------------------------------
# 3. Application Environment
# -------------------------------------------------------------
# 'development' | 'production'
APP_ENV=development

# -------------------------------------------------------------
# 4. Optional Backend External Integrations
# -------------------------------------------------------------
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a
NOTIFICATION_PROVIDER=console
